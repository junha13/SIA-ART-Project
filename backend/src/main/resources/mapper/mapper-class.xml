<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="lx.team2.backend.feature.classes.ClassDAO">

    <resultMap id="classMap" type="ClassVO">
        <id     column="class_number"           property="classNumber"/>
        <result column="class_name"             property="className"/>
        <result column="subtitle"               property="subtitle"/>
        <result column="class_description"      property="classDescription"/>
        <result column="class_image"            property="classImage"/>
        <result column="user_number"            property="userNumber"/>
        <result column="instructor"             property="instructor"/>
        <result column="instructor_avatar"      property="instructorAvatar"/>
        <result column="level"                  property="level"/>
        <result column="capacity"               property="capacity"/>
        <result column="price"                  property="price"/>
        <result column="materials_included"     property="materialsIncluded"/>
        <result column="curriculum"             property="curriculum"/>
        <result column="start_date"             property="startDate"/>
        <result column="end_date"               property="endDate"/>
        <result column="class_time"             property="classTime"/>
        <result column="days"                   property="days"/>
        <result column="duration_weeks"         property="durationWeeks"/>
        <result column="is_daily"               property="isDaily"/>
        <result column="class_category_number"  property="classCategoryNumber"/>
        <result column="location"               property="location"/>
        <result column="categoryName"           property="categoryName"/>
    </resultMap>

    <select id="selectClasses" parameterType="ClassVO" resultMap="classMap">
        SELECT
        t.*, -- tb_class의 모든 컬럼 선택
        c.class_category_name AS categoryName
        FROM
        tb_class t
        LEFT JOIN
        tb_class_category c ON t.class_category_number = c.class_category_number
        WHERE 1=1
        <if test="categoryName != null and categoryName != '' and categoryName != '전체'">
            AND c.class_category_name = #{categoryName}
        </if>
        <if test="searchKeyword != null and searchKeyword != ''">
            AND (
            t.class_name LIKE '%' || #{searchKeyword} || '%' OR
            t.subtitle LIKE '%' || #{searchKeyword} || '%' OR
            t.instructor LIKE '%' || #{searchKeyword} || '%'
            )
        </if>
        ORDER BY t.class_number DESC
    </select>

    <select id="selectClassDetail" parameterType="int" resultMap="classMap">
        SELECT
            t.*, -- tb_class의 모든 컬럼 선택
            c.class_category_name AS categoryName
        FROM
            tb_class t
                LEFT JOIN
            tb_class_category c ON t.class_category_number = c.class_category_number
        WHERE
            t.class_number = #{classNumber}
    </select>

    <insert id="insertClass" parameterType="ClassVO" useGeneratedKeys="true" keyProperty="classNumber">
        INSERT INTO tb_class (
        class_name, class_description, user_number, class_category_number, start_date, end_date,
        class_time, location
        )
        VALUES (
        #{className},
        #{classDescription},
        #{userNumber},
        #{classCategoryNumber},
        #{startDate},
        #{endDate},
        #{classTime},
        <!-- 문자열을 WKT로 받음 -->
        ST_SetSRID(ST_GeomFromText(#{location}), 4326)
        )
    </insert>

    <insert id="insertClassKeywordLink">
        INSERT INTO tb_class_keyword (class_number, keyword_number)
        VALUES (#{classNumber}, #{keywordNumber})
    </insert>

    <select id="selectKeywordNumberByName" parameterType="String" resultType="int">
        SELECT keyword_number FROM tb_detail_keyword WHERE keyword_name = #{keywordName}
    </select>

</mapper>
